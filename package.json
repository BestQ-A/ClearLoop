{
  "name": "clearloop",
  "displayName": "ClearLoop",
  "publisher": "bestqa",
  "description": "Clear AI control plane for turning agent relevance into explicit causal plans, evidence, verification, and reusable memory.",
  "version": "2.0.6",
  "license": "Apache-2.0",
  "icon": "media/codesail_app.png",
  "keywords": [
    "AI",
    "coding agent",
    "clear ai",
    "causal planning",
    "planning layer",
    "agent orchestration",
    "code analysis",
    "reverse engineering",
    "verification"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BestQ-A/ClearLoop.git"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*",
    "onView:clearLoop.commentNavigatorWebview",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "clearLoopNavigator",
          "title": "ClearLoop",
          "icon": "./media/codesail-sidebar.svg"
        }
      ]
    },
    "views": {
      "clearLoopNavigator": [
        {
          "id": "clearLoop.commentNavigatorWebview",
          "name": "ClearLoop",
          "type": "webview",
          "icon": "./media/codesail_app.png"
        }
      ]
    },
    "commands": [
      { "command": "clearLoop.startNewTask", "title": "ClearLoop: Start New Task" },
      { "command": "clearLoop.openTaskHistory", "title": "ClearLoop: Open Task History" },
      { "command": "clearLoop.listMCPServers", "title": "ClearLoop: List MCP Servers" },
      { "command": "clearLoop.managePromptTemplates", "title": "ClearLoop: Manage Prompt Templates" },
      { "command": "clearLoop.manageCLIAgents", "title": "ClearLoop: Manage CLI Agents" },
      { "command": "clearLoop.manageWorkflows", "title": "ClearLoop: Manage Workflows" },
      { "command": "clearLoop.manageGitScripts", "title": "ClearLoop: Manage Git Scripts" },
      { "command": "clearLoop.manageModelProfiles", "title": "ClearLoop: Manage Model Profiles" },
      { "command": "clearLoop.openEpicView", "title": "ClearLoop: Open Epic View" },
      { "command": "clearLoop.openSettings", "title": "ClearLoop: Open Settings" },
      { "command": "clearLoop.analyzeFile", "title": "ClearLoop: Analyze Current File" },
      { "command": "clearLoop.analyzeChanges", "title": "ClearLoop: Analyze Changes" },
      { "command": "clearLoop.createCliHandoff", "title": "ClearLoop: Create CLI Agent Handoff Smoke" },
      { "command": "clearLoop.checkCliAgents", "title": "ClearLoop: Check CLI Agents" },
      { "command": "clearLoop.startCliAgentRun", "title": "ClearLoop: Start CLI Agent Run" },
      { "command": "clearLoop.captureCliAgentResult", "title": "ClearLoop: Capture CLI Agent Result" },
      { "command": "clearLoop.verifyRunResult", "title": "ClearLoop: Verify Run Result" },
      { "command": "clearLoop.recordRunLedgerResult", "title": "ClearLoop: Record Run Ledger Result" },
      { "command": "clearLoop.codexLogin", "title": "ClearLoop: Codex Login" },
      { "command": "clearLoop.codexStatus", "title": "ClearLoop: Codex Login Status" }
    ],
    "configuration": {
      "title": "ClearLoop",
      "properties": {
        "clearLoop.defaultProvider": {
          "type": "string",
          "default": "ollama",
          "description": "Default LLM provider"
        },
        "clearLoop.defaultModel": {
          "type": "string",
          "default": "qwen3.5:9b",
          "description": "Default model name"
        },
        "clearLoop.apiEndpoint": {
          "type": "string",
          "default": "",
          "description": "Custom API endpoint (OpenAI-compatible)"
        },
        "clearLoop.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for remote providers"
        },
        "clearLoop.enableStreaming": {
          "type": "boolean",
          "default": true,
          "description": "Enable streaming responses"
        },
        "clearLoop.executionAgent": {
          "type": "string",
          "enum": ["claude-code", "codex-cli", "codex", "cursor", "copilot", "cline", "roo-code", "custom"],
          "default": "claude-code",
          "description": "Default execution agent for YOLO mode"
        },
        "clearLoop.yoloMaxRetries": {
          "type": "number",
          "default": 3,
          "description": "Max verification retries in YOLO mode"
        },
        "clearLoop.outputLevel": {
          "type": "string",
          "enum": ["error", "warn", "info", "debug"],
          "default": "info",
          "description": "Output log level"
        },
        "clearLoop.languagePreference": {
          "type": "string",
          "enum": ["en", "zh-CN", "zh-TW", "ja", "ko", "es", "fr", "de", "pt", "ru"],
          "default": "en",
          "description": "Language preference for AI responses"
        },
        "clearLoop.enablePromptTemplateSelector": {
          "type": "boolean",
          "default": true,
          "description": "Show prompt template selector entries in ClearLoop settings."
        },
        "clearLoop.additionalAgents": {
          "type": "array",
          "default": [],
          "description": "Additional custom CLI agents exposed in ClearLoop."
        },
        "clearLoop.sendKey": {
          "type": "string",
          "default": "enter",
          "description": "Key behavior for sending prompts from the ClearLoop composer."
        },
        "clearLoop.enableAgentsMd": {
          "type": "boolean",
          "default": true,
          "description": "Allow ClearLoop to use AGENTS.md guidance when preparing tasks."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:rust && npm run compile && npm run bundle:extension && npm run build-webview",
    "build:rust": "cd codesail-server && cargo build --release && node -e \"const fs=require('fs');const path=require('path');fs.mkdirSync('../bin',{recursive:true});const exe=process.platform==='win32'?'codesail-server.exe':'codesail-server';fs.copyFileSync(path.join('target','release',exe),path.join('..','bin',exe));\"",
    "bundle:extension": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=es2020 --sourcemap",
    "compile": "tsc -p ./",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=es2020 --watch",
    "build-webview": "cd webview-ui && npm run build",
    "pretest": "npm run build && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "dev": "npm run build:rust && npm run compile && npm run bundle:extension && npm run build-webview"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "groq-sdk": "^0.7.0",
    "ollama": "^0.6.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.7.4",
    "@types/vscode": "^1.93.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.10",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3"
  }
}
